option(
  'link_mode',
  type: 'combo',
  choices: ['shared', 'static'],
  value: 'shared',
  description: 'How libpkgstate links against external dependencies',
)
option(
  'tests',
  type: 'feature',
  value: 'enabled',
  description: 'Build and run the libpkgstate test suite',
)
option(
  'tools',
  type: 'feature',
  value: 'enabled',
  description: 'Build reference command-line tools',
)
option(
  'install_tools',
  type: 'boolean',
  value: false,
  description: 'Install reference command-line tools',
)
option(
  'man_pages',
  type: 'feature',
  value: 'auto',
  description: 'Build manual pages with scdoc',
)
